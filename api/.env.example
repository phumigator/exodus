EXODUS_WHISPER_API_BASE_URL=http://remote-host:9000
EXODUS_OPENROUTER_API_KEY=sk-or-v1-...
EXODUS_OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Заполнить, только если прямые запросы к openrouter.ai блокируются
# (см. локальный VPN/прокси-клиент, если он используется на этой машине)
EXODUS_OPENROUTER_MODEL=google/gemma-4-31b-it:free
EXODUS_OPENROUTER_PROXY_URL=
EXODUS_DATABASE_URL=postgresql://user:password@remote-host:5432/analytics
EXODUS_CORS_ORIGINS=["*"]
