# Раздел /analytics/ (News Analytics) подключается к Postgres на локальной машине
# разработчика тем же способом, что whisper-bridge — через проброшенный на роутере
# порт, отдельным read-only пользователем dashboard_ro (только SELECT на companies/news).
EXODUS_NEWS_DB_URL=postgresql+psycopg2://dashboard_ro:<ПАРОЛЬ_DASHBOARD_RO>@<ВНЕШНИЙ_IP>:5432/n8n
